# Copie para .env e preencha os dois valores obrigatorios.
# Use valores hexadecimais aleatorios (sem caracteres reservados de URL).
POSTGRES_DB=zirphas_os
POSTGRES_USER=zirphas
POSTGRES_PASSWORD=
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=[]
# Failed staff logins allowed per client IP and e-mail within the window (seconds).
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# Somente para executar Python fora do Docker: configure a URL usando sua senha.
# DATABASE_URL=postgresql+psycopg://zirphas:SUA_SENHA_HEXADECIMAL@localhost:5432/zirphas_os
# UPLOAD_DIR=uploads
